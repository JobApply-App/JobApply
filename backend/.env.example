# ─────────────────────────────────────────────────────────────────────────────
# Backend environment variables — copy this file to backend/.env and fill in
# real values. backend/.env is gitignored; never commit real secrets there.
#
# Every variable below is loaded and validated in backend/config.py — that
# module is the single source of truth for names, defaults, and which
# variables are required vs. optional. By default (STRICT_CONFIG=false),
# missing required variables only log a loud startup warning; they do not
# crash the server (see backend/config.py::_validate_required_env for why).
# ─────────────────────────────────────────────────────────────────────────────

# Strict startup validation. false (default) = safe for local development —
# missing required vars only warn. true = fail fast — the process crashes
# immediately at startup if a required variable is missing, instead of
# serving traffic in a half-configured state.
#
# PRODUCTION SHOULD SET STRICT_CONFIG=true.
STRICT_CONFIG=false

# Which environment this process is running as. Picks between the _DEV and
# _PROD variants of DATABASE_URL/SUPABASE_URL/SUPABASE_JWT_SECRET below (see
# that section), and controls CORS origin selection (see CORS_ALLOWED_ORIGINS
# further down). PYTHON_ENV is accepted as an alias if you prefer that name;
# ENVIRONMENT (the old name) still works too — all three are the same flag.
# "dev"/"develop" and "prod" are accepted as shorthand.
#
# PRODUCTION DEPLOYMENTS SHOULD SET APP_ENV=production.
APP_ENV=development


# ── Required ─────────────────────────────────────────────────────────────────

# Every LLM-driven feature (matching, scoring, tailoring, chat, outreach)
# depends on this. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# At least one of the two below must be set for authenticated endpoints to
# return anything other than HTTP 503.

# Enables the RS256/JWKS flow — use this for a hosted Supabase project.
SUPABASE_URL=https://your-project-ref.supabase.co

# Enables the HS256 fallback — use this for local/self-hosted Supabase.
# Dashboard → Project Settings → API → JWT Settings → JWT Secret.
# Must be the raw signing secret, NOT the anon/service-role key (a key
# starting with "eyJ" is rejected — that's a JWT, not a signing secret).
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ── RapidAPI LinkedIn-jobs provider (used by POST /api/jobs/analyze) ───────────
# Required for scrape_linkedin_job() in backend/scrapers/url_router.py.
# Defaults match the subscribed provider, "LinkedIn Job Search API" by
# Fantastic Jobs (a filtered-search endpoint, not a get-by-id lookup — see
# url_router.py for the linkedin_id/time_frame/description_format params).
# All four are swappable via env without a code change if you subscribe to a
# different RapidAPI LinkedIn-jobs listing.
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_LINKEDIN_HOST=linkedin-job-search-api.p.rapidapi.com
RAPIDAPI_LINKEDIN_PATH=/active-jb
RAPIDAPI_LINKEDIN_TIME_FRAME=6m

# ── Optional — feature-specific; the app runs fine without these ────────────

# Enables live company-research lookups in agents/matching_engine.py.
# Without it: a labelled fallback ("no external data available") is returned.
TAVILY_API_KEY=your_tavily_api_key_here

# Primary backend for services/web_search.py (used by agents/researcher.py's
# ResearcherAgent for entity/domain verification and vocabulary-gap analysis).
# Uses ScraperAPI's structured Google Search endpoint — real credits are spent
# per call (observed: 25 credits/request as of 2026-07; check your plan).
# Without SCRAPER_API_KEY (or with USE_SCRAPER_API=false): falls back to
# unauthenticated DuckDuckGo HTML scraping, which DuckDuckGo has been observed
# blocking with an anti-bot CAPTCHA challenge — treat that path as unreliable,
# not a real backend.
SCRAPER_API_KEY=your_scraperapi_key_here
USE_SCRAPER_API=true

# Enables llm_client.py's automatic Gemini fallback: if every Anthropic
# attempt fails (missing/invalid ANTHROPIC_API_KEY, outage, etc.), plain
# text/tool-free calls retry once against Gemini instead of failing outright.
# Get a key at https://aistudio.google.com/apikey . Without it: those calls
# just fail the same way they did before this fallback existed.
GEMINI_API_KEY=your_gemini_api_key_here

# Shared secret the inbound-email webhook checks via the X-Webhook-Secret
# header (backend/api/routes/webhooks.py). Without it: the webhook still
# works but accepts unauthenticated requests (a warning is logged at startup).
EMAIL_WEBHOOK_SECRET=your_webhook_shared_secret_here

# (Old name for APP_ENV, set at the top of this file — still read as a
# fallback if APP_ENV isn't set. No need to set both; pick one name.)
# ENVIRONMENT=development

# Comma-separated list of browser origins allowed to call this API.
# Only read (and only required) when APP_ENV=production — in development
# the origin list is a fixed localhost allow-list instead. If
# APP_ENV=production and this is left unset, NO origin is allowed
# (fails closed) and a startup error is logged.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com


# ── Shared Postgres (Supabase) — Dev / Prod ─────────────────────────────────
# Used ONLY by backend/core/postgres.py (backend/models/linkedin_job.py's
# `linkedin.jobs` table + its Alembic migrations, backend/alembic_linkedin/).
# The app's primary datastore is still SQLite (backend/jobs.db) — this is
# NOT a general Postgres migration, just the multi-user-shared piece.
#
# Both a Dev and a Prod Supabase project's credentials can live here at the
# same time — APP_ENV above picks which set is actually used at runtime
# (backend/config.py's _select_env_var()). Populate whichever of the two
# blocks you actually have a Supabase project for; leave the other's values
# as placeholders until that project exists.
#
# Where to find these in Supabase: Project Settings → Database → Connection
# string / Connection parameters. Three connection types are offered —
# picking the right one matters:
#   - Direct connection   (port 5432) — no pgbouncer. Fine for this app
#     (single long-running backend process, not serverless).
#   - Session pooler      (port 5432, pgbouncer session mode) — also fine,
#     useful if direct connections are IPv6-only on your network and you
#     need IPv4.
#   - Transaction pooler  (port 6543, pgbouncer transaction mode) — backend/
#     core/postgres.py detects port 6543 automatically and switches to
#     NullPool to avoid double-pooling on top of pgbouncer; use this if
#     you expect many short-lived connections (e.g. serverless/edge
#     deploys), not needed for a normal single-process backend.
# TLS: backend/core/postgres.py adds sslmode=require automatically for any
# non-localhost host, so you don't need to add it to the URL yourself.

# Explicit override — if set, this ALWAYS wins over the _DEV/_PROD pair
# below, regardless of APP_ENV. Leave unset to let APP_ENV do the picking;
# only set this for a one-off/manual target (e.g. a personal scratch DB).
# DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Dev Supabase project (APP_ENV=development uses this).
DATABASE_URL_DEV=postgresql://postgres:your_dev_db_password@db.your-dev-project-ref.supabase.co:5432/postgres
SUPABASE_URL_DEV=https://your-dev-project-ref.supabase.co
SUPABASE_JWT_SECRET_DEV=your_dev_supabase_jwt_secret_here

# Prod Supabase project (APP_ENV=production uses this).
DATABASE_URL_PROD=postgresql://postgres:your_prod_db_password@db.your-prod-project-ref.supabase.co:5432/postgres
SUPABASE_URL_PROD=https://your-prod-project-ref.supabase.co
SUPABASE_JWT_SECRET_PROD=your_prod_supabase_jwt_secret_here

# Alternative to DATABASE_URL_DEV/_PROD: discrete connection fields (also
# _DEV/_PROD-suffixed), built into a DSN by backend/config.py if no
# DATABASE_URL[_DEV/_PROD] is set. Useful if you copy Supabase's "Connection
# parameters" view instead of its single connection-string view — same
# Project Settings → Database page has both.
# DB_HOST_DEV=db.your-dev-project-ref.supabase.co
# DB_PORT_DEV=5432
# DB_NAME_DEV=postgres
# DB_USER_DEV=postgres
# DB_PASSWORD_DEV=your_dev_db_password
# DB_HOST_PROD=db.your-prod-project-ref.supabase.co
# DB_PORT_PROD=5432
# DB_NAME_PROD=postgres
# DB_USER_PROD=postgres
# DB_PASSWORD_PROD=your_prod_db_password

# Not read by the backend directly (frontend-only — see frontend/.env.example
# and frontend/src/app/api/auth/check-email/route.ts), listed here only so
# this file is a complete per-project checklist for whoever sets up a new
# Supabase Dev/Prod pair. SUPABASE_ANON_KEY is the client-safe key (RLS
# enforces access control); SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely
# and must never reach the browser bundle.
# SUPABASE_ANON_KEY_DEV=your_dev_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY_DEV=your_dev_supabase_service_role_key_here
# SUPABASE_ANON_KEY_PROD=your_prod_supabase_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY_PROD=your_prod_supabase_service_role_key_here

# REDIS_URL=redis://localhost:6379/0
